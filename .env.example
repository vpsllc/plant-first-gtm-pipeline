# Copy to .env and fill in. .env is gitignored.

# Firecrawl API key (https://firecrawl.dev)
FIRECRAWL_API_KEY=fc-your-key-here

# Hard ceiling on Firecrawl credits across all script runs (tracked in out/credit_ledger.jsonl).
FIRECRAWL_CREDIT_CAP=300

# SEC EDGAR requires a descriptive User-Agent with a contact email. Free, no key.
SEC_USER_AGENT=Your Name your-email@example.com
